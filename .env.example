# Database
DB_NAME=trucksmarter
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432

# Django Settings
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_aplicacion
DEFAULT_FROM_EMAIL=TruckSmarter <tu_email@gmail.com>

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Web origin and external integrations
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
EMAIL_VALIDATE_DNS=False
EMAIL_VERIFICATION_API_KEY=

# JWT deshabilitado hasta definir una clave independiente aleatoria de >=32 bytes.
# Generar con: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SIGNING_KEY=
# CORS cerrado por defecto; lista exacta separada por comas, nunca '*'.
CORS_ALLOWED_ORIGINS=
REQUESTS_PER_MINUTE=120
WRITES_PER_MINUTE=30
# Activar SOLO con origen privado y accesible exclusivamente por el túnel.
CLOUDFLARED_ENABLED=False
CLOUDFLARED_TRUSTED_PEERS=127.0.0.1,::1
